# Development Environment Configuration
# These variables are exposed to the client via Vite's env handling (VITE_ prefix)

# API Base URL for local development (adjust port as needed for your backend)
VITE_API_BASE_URL=http://localhost:3001/api

# Optional: WebSocket endpoint for real-time features
VITE_WS_URL=ws://localhost:3001

# Feature flags (examples)
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_DEBUG_TOOLS=true